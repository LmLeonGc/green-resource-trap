# ---- Environments ----
.venv/
venv/
env/
__pycache__/
*.py[cod]

# ---- Jupyter ----
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/

# ---- Data: keep structure, protect raw provenance ----
# Raw downloads are tracked-by-reference in data/sources.md, NOT committed
# (large/licensed files stay local; provenance is documented instead)
data/raw/*
!data/raw/.gitkeep

# Processed tables ARE committed (they are your reproducible outputs)
# data/processed/  -> keep tracked

# ---- Outputs that are regenerated by code ----
!outputs/figures/.gitkeep

# ---- Secrets / scratch ----
.env
scratch/
*.log
